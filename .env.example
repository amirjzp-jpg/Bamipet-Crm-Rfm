# ── Bamipet RFM — environment configuration ────────────────────────────────
# Copy to .env and fill in. Values here are read by docker-compose and the
# backend (API + worker). Never commit the real .env.

# --- Database (docker-compose wires DATABASE_URL from these) ---
POSTGRES_USER=bamipet
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bamipet_rfm

# --- Auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# First admin account — used once by: docker compose exec api python -m scripts.create_admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-min-8-chars

# --- Web ---
WEB_PORT=8080

# ── Navatel (THE ONLY REMAINING INPUT to go live) ──────────────────────────
# All five values come from the Swagger docs behind login at cp.navatel.ir
# (panel → API/webservice section). Until then, mock mode serves realistic
# demo data so the whole product is usable end to end.

NAVATEL_MODE=mock                        # switch to "live" when the values below are real
NAVATEL_BASE_URL=https://api.navatel.ir  # the Swagger "servers" block URL
NAVATEL_API_TOKEN=                       # Bearer token generated in the panel

# The four endpoint paths from the Swagger docs:
NAVATEL_ENDPOINT_CONTACTS=/crm/v1/contacts
NAVATEL_ENDPOINT_ORDERS=/crm/v1/invoices
NAVATEL_ENDPOINT_CALLS=/call/v1/logs
NAVATEL_ENDPOINT_SMS=/messaging/v1/logs

# Pagination param names, if different in the real API:
NAVATEL_PAGE_PARAM=page
NAVATEL_PAGE_SIZE_PARAM=page_size
NAVATEL_PAGE_SIZE=200

# Field-name mapping: canonical name -> real Navatel field name, as JSON.
# Only override what differs. Example (uncomment and adjust):
# NAVATEL_FIELD_ALIASES={"orders": {"id": "faktor_id", "amount": "mablagh_kol", "created_at": "tarikh_sabt"}}
NAVATEL_FIELD_ALIASES=

# Write-back of segment/persona onto Navatel contacts. Keep false until the
# custom fields below are confirmed to exist in the CRM schema.
ENABLE_WRITEBACK=false
SEGMENT_FIELD_NAME=bamipet_rfm_segment
PERSONA_FIELD_NAME=bamipet_persona_guess

# --- RFM engine / scheduler ---
LOOKBACK_DAYS=365
SYNC_CRON_HOUR=2
SYNC_CRON_MINUTE=30
